.macro glabel label
    .global \label
    .type \label, @function
    \label:
.endm

.macro dlabel label
    .global \label
    \label:
.endm

.macro jlabel label
    .global \label
    .type \label, @function
    \label:
.endm

# spimdisasm emits these two markers from GlobalConfig defaults that splat does
# not expose as options (ASM_NM_LABEL and ASM_DATA_END_LABEL), so they cannot be
# turned off from smashbrothers.yaml and must be defined here instead.
#
# Both are purely informational: spimdisasm emits the real label separately
# (verified -- all 635 `nonmatching` markers are followed by a glabel/dlabel,
# and all 295 `enddlabel` markers are followed by their own `.size`), so these
# expand to nothing. Do NOT delete the markers from the generated asm: `asm/`
# is regenerated by `gmake extract` and they will simply come back.

# Marks a symbol that does not currently match. `size` is absent for symbols of
# unknown length, so it needs a default.
.macro nonmatching label, size=0
.endm

# Marks the end of a data symbol. The matching `.size` directive is emitted by
# spimdisasm on the following line.
.macro enddlabel label
.endm

